local oldRaycast
oldRaycast = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if silentAimEnabled and currentTargetPart and (method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") then
        if tostring(self) == "Workspace" then
            local origin = args[1]
            if typeof(origin) == "Vector3" then
                args[2] = (currentTargetPart.Position - origin).Unit * 1000
                return oldRaycast(self, unpack(args))
            end
        end
    end
    return oldRaycast(self, ...)
end)

