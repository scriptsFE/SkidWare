RunService.RenderStepped:Connect(function()
    local mouseLocationData = UserInputService:GetMouseLocation()
    local viewportSizeData = Camera.ViewportSize
    local screenCenterVector = Vector2.new(viewportSizeData.X / 2, viewportSizeData.Y / 2)
    local screenCenterBottomOffset = Vector2.new(viewportSizeData.X / 2, viewportSizeData.Y)
    
    local isMobile = (UserInputService.TouchEnabled and not UserInputService.MouseEnabled)
    local activeAnchor = isMobile and screenCenterVector or mouseLocationData

    if rainbowWeaponEnabled then
        local hue = (tick() % 3) / 3
        local rainbowColor = Color3.fromHSV(hue, 1, 1)
        local characterModelData = LocalPlayer.Character
        if characterModelData then
            local equippedTool = characterModelData:FindFirstChildOfClass("Tool")
            if equippedTool then
                for _, descendant in pairs(equippedTool:GetDescendants()) do
                    if descendant:IsA("Texture") then
                        if not removedTexturesCache[descendant] then
                            removedTexturesCache[descendant] = {
                                Texture = descendant.Texture
                            }
                        end
                        descendant.Texture = ""
                    elseif descendant:IsA("MeshPart") then
                        if not originalWeaponProperties[descendant] then
                            originalWeaponProperties[descendant] = {
                                Color = descendant.Color,
                                Transparency = descendant.Transparency,
                                Material = descendant.Material,
                                TextureID = descendant.TextureID
                            }
                        end
                        descendant.Color = rainbowColor
                        descendant.Transparency = 0.4
                        descendant.Material = Enum.Material.Neon
                        descendant.TextureID = ""
                    elseif descendant:IsA("SpecialMesh") then
                        if not originalWeaponProperties[descendant] then
                            originalWeaponProperties[descendant] = {
                                TextureId = descendant.TextureId,
                                VertexColor = descendant.VertexColor
                            }
                        end
                        descendant.TextureId = ""
                        descendant.VertexColor = Vector3.new(1, 1, 1)
                        
                        local parentPart = descendant.Parent
                        if parentPart and parentPart:IsA("BasePart") then
                            if not originalWeaponProperties[parentPart] then
                                originalWeaponProperties[parentPart] = {
                                    Color = parentPart.Color,
                                    Transparency = parentPart.Transparency,
                                    Material = parentPart.Material
                                }
                            end
                            parentPart.Color = rainbowColor
                            parentPart.Transparency = 0.4
                            parentPart.Material = Enum.Material.Neon
                        end
                    elseif descendant:IsA("BasePart") then
                        if not originalWeaponProperties[descendant] then
                            originalWeaponProperties[descendant] = {
                                Color = descendant.Color,
                                Transparency = descendant.Transparency,
                                Material = descendant.Material
                            }
                        end
                        descendant.Color = rainbowColor
                        descendant.Transparency = 0.4
                        descendant.Material = Enum.Material.Neon
                    end
                end
            end
        end
    end

    if aimbotEnabled then
        targetingReticle.main.Radius = aimbotRadius
        targetingReticle.main.Position = activeAnchor
        targetingReticle.inner.Radius = aimbotRadius - 1
        targetingReticle.inner.Position = activeAnchor
        targetingReticle.outer.Radius = aimbotRadius + 1
        targetingReticle.outer.Position = activeAnchor
        
        targetingReticle.main.Visible = true
        targetingReticle.inner.Visible = true
        targetingReticle.outer.Visible = true
    else
        targetingReticle.main.Visible = false
        targetingReticle.inner.Visible = false
        targetingReticle.outer.Visible = false
    end
    
    local targetLockedOnEnemy = nil
    local closestSelectionDistance = math.huge

    for npc, obj in pairs(cache) do
        if not npc or not npc.Parent then
            removeEsp(npc)
        else
            local rootPartCharacterData = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head")
            local humanoidCharacterData = npc:FindFirstChildOfClass("Humanoid")
            
            if rootPartCharacterData and humanoidCharacterData and humanoidCharacterData.Health > 0 then
                local rootCFrameCharacterData, rootSizeCharacterData = npc:GetBoundingBox()
                local topPositionScreenCharacterData, topOnScreenCharacterData = Camera:WorldToViewportPoint((rootCFrameCharacterData * CFrame.new(0, rootSizeCharacterData.Y / 2, 0)).Position)
                local bottomPositionScreenCharacterData, bottomOnScreenCharacterData = Camera:WorldToViewportPoint((rootCFrameCharacterData * CFrame.new(0, -rootSizeCharacterData.Y / 2, 0)).Position)
                
                local magnitudeDistanceCharacterData = (Camera.CFrame.Position - rootPartCharacterData.Position).Magnitude
                
                if espEnabled and (topOnScreenCharacterData or bottomOnScreenCharacterData) then
                    local heightFrameBoundsCharacterData = math.abs(topPositionScreenCharacterData.Y - bottomPositionScreenCharacterData.Y)
                    local widthFrameBoundsCharacterData = heightFrameBoundsCharacterData * 0.6
                    local xOriginFrameBoundsCharacterData = bottomPositionScreenCharacterData.X - (widthFrameBoundsCharacterData / 2)
                    local yOriginFrameBoundsCharacterData = topPositionScreenCharacterData.Y
                    local xEndFrameBoundsCharacterData, yEndFrameBoundsCharacterData = xOriginFrameBoundsCharacterData + widthFrameBoundsCharacterData, yOriginFrameBoundsCharacterData + heightFrameBoundsCharacterData
                    
                    obj.t.From = Vector2.new(xOriginFrameBoundsCharacterData, yOriginFrameBoundsCharacterData)   obj.t.To = Vector2.new(xEndFrameBoundsCharacterData, yOriginFrameBoundsCharacterData)
                    obj.b.From = Vector2.new(xOriginFrameBoundsCharacterData, yEndFrameBoundsCharacterData)  obj.b.To = Vector2.new(xEndFrameBoundsCharacterData, yEndFrameBoundsCharacterData)
                    obj.l.From = Vector2.new(xOriginFrameBoundsCharacterData, yOriginFrameBoundsCharacterData)   obj.l.To = Vector2.new(xOriginFrameBoundsCharacterData, yEndFrameBoundsCharacterData)
                    obj.r.From = Vector2.new(xEndFrameBoundsCharacterData, yOriginFrameBoundsCharacterData)  obj.r.To = Vector2.new(xEndFrameBoundsCharacterData, yEndFrameBoundsCharacterData)
                    
                    obj.ot.From = Vector2.new(xOriginFrameBoundsCharacterData - 1, yOriginFrameBoundsCharacterData - 1)   obj.ot.To = Vector2.new(xEndFrameBoundsCharacterData + 1, yOriginFrameBoundsCharacterData - 1)
                    obj.ob.From = Vector2.new(xOriginFrameBoundsCharacterData - 1, yEndFrameBoundsCharacterData + 1)  obj.ob.To = Vector2.new(xEndFrameBoundsCharacterData + 1, yEndFrameBoundsCharacterData + 1)
                    obj.ol.From = Vector2.new(xOriginFrameBoundsCharacterData - 1, yOriginFrameBoundsCharacterData - 1)   obj.ol.To = Vector2.new(xOriginFrameBoundsCharacterData - 1, yEndFrameBoundsCharacterData + 1)
                    obj.or_.From = Vector2.new(xEndFrameBoundsCharacterData + 1, yOriginFrameBoundsCharacterData - 1)  obj.or_.To = Vector2.new(xEndFrameBoundsCharacterData + 1, yEndFrameBoundsCharacterData + 1)
                    
                    obj.it.From = Vector2.new(xOriginFrameBoundsCharacterData + 1, yOriginFrameBoundsCharacterData + 1)   obj.it.To = Vector2.new(xEndFrameBoundsCharacterData - 1, yOriginFrameBoundsCharacterData + 1)
                    obj.ib.From = Vector2.new(xOriginFrameBoundsCharacterData + 1, yEndFrameBoundsCharacterData - 1)  obj.ib.To = Vector2.new(xEndFrameBoundsCharacterData - 1, yEndFrameBoundsCharacterData - 1)
                    obj.il.From = Vector2.new(xOriginFrameBoundsCharacterData + 1, yOriginFrameBoundsCharacterData + 1)   obj.il.To = Vector2.new(xOriginFrameBoundsCharacterData + 1, yEndFrameBoundsCharacterData - 1)
                    obj.ir.From = Vector2.new(xEndFrameBoundsCharacterData - 1, yEndFrameBoundsCharacterData + 1)  obj.ir.To = Vector2.new(xEndFrameBoundsCharacterData - 1, yEndFrameBoundsCharacterData - 1)
                    
                    obj.t.Visible = true; obj.b.Visible = true; obj.l.Visible = true; obj.r.Visible = true
                    obj.ot.Visible = true; obj.ob.Visible = true; obj.ol.Visible = true; obj.or_.Visible = true
                    obj.it.Visible = true; obj.ib.Visible = true; obj.il.Visible = true; obj.ir.Visible = true
                    
                    if magnitudeDistanceCharacterData < 400 then
                        local fontSizeFrameCharacterData = math.clamp(math.floor(13 - (magnitudeDistanceCharacterData / 45)), 9, 13)
                        
                        obj.hp.Size = fontSizeFrameCharacterData
                        obj.hp.Text = math.floor(humanoidCharacterData.Health) .. "hp"
                        obj.hp.Position = Vector2.new(bottomPositionScreenCharacterData.X, yEndFrameBoundsCharacterData + 2)
                        obj.hp.Visible = true
                    else
                        obj.hp.Visible = false
                    end
                else
                    obj.t.Visible = false; obj.b.Visible = false; obj.l.Visible = false; obj.r.Visible = false
                    obj.ot.Visible = false; obj.ob.Visible = false; obj.ol.Visible = false; obj.or_.Visible = false
                    obj.it.Visible = false; obj.ib.Visible = false; obj.il.Visible = false; obj.ir.Visible = false
                    obj.hp.Visible = false
                end
                
                if tracersEnabled and bottomOnScreenCharacterData then
                    local vector2OriginCharacterData = Vector2.new(bottomPositionScreenCharacterData.X, bottomPositionScreenCharacterData.Y)
                    obj.tracerMain.From = screenCenterBottomOffset
                    obj.tracerMain.To = vector2OriginCharacterData
                    
                    local magnitudeMagnitudeTracerVectorData = (vector2OriginCharacterData - screenCenterBottomOffset).Magnitude
                    if magnitudeMagnitudeTracerVectorData > 0 then
                        local vector2NormalVectorData = (vector2OriginCharacterData - screenCenterBottomOffset).Unit
                        local vector2TangentVectorData = Vector2.new(-vector2NormalVectorData.Y, vector2NormalVectorData.X)
                        
                        obj.tracerLeftOutline.From = screenCenterBottomOffset - vector2TangentVectorData
                        obj.tracerLeftOutline.To = vector2OriginCharacterData - vector2TangentVectorData
                        
                        obj.tracerRightOutline.From = screenCenterBottomOffset + vector2TangentVectorData
                        obj.tracerRightOutline.To = vector2OriginCharacterData + vector2TangentVectorData
                        
                        obj.tracerMain.Visible = true
                        obj.tracerLeftOutline.Visible = true
                        obj.tracerRightOutline.Visible = true
                    else
                        obj.tracerMain.Visible = false
                        obj.tracerLeftOutline.Visible = false
                        obj.tracerRightOutline.Visible = false
                    end
                else
                    obj.tracerMain.Visible = false
                    obj.tracerLeftOutline.Visible = false
                    obj.tracerRightOutline.Visible = false
                end

                if aimbotEnabled and magnitudeDistanceCharacterData < maxTargetDistanceStuds and (topOnScreenCharacterData or bottomOnScreenCharacterData) then
                    local screenPos = Vector2.new(bottomPositionScreenCharacterData.X, (topPositionScreenCharacterData.Y + bottomPositionScreenCharacterData.Y) / 2)
                    local screenDistance = (screenPos - activeAnchor).Magnitude
                    
                    if screenDistance < aimbotRadius and screenDistance < closestSelectionDistance then
                        closestSelectionDistance = screenDistance
                        targetLockedOnEnemy = rootPartCharacterData
                    end
                end
            else
                for _, item in pairs(obj) do
                    item.Visible = false
                end
            end
        end
    end

    currentTargetPart = targetLockedOnEnemy

    if currentTargetPart and aimbotEnabled then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, currentTargetPart.Position)
        
        if triggerbotEnabled and not fireDebounce then
            fireDebounce = true
            
            if isMobile then
                local equippedTool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if equippedTool then
                    equippedTool:Activate()
                end
                task.wait(fireRateDelay)
                fireDebounce = false
            else
                task.spawn(function()
                    VirtualInputManager:SendMouseButtonEvent(activeAnchor.X, activeAnchor.Y, 0, true, game, 1)
                    task.wait(0.02)
                    VirtualInputManager:SendMouseButtonEvent(activeAnchor.X, activeAnchor.Y, 0, false, game, 1)
                    task.wait(fireRateDelay)
                    fireDebounce = false
                end)
            end
        end
    end
end)
