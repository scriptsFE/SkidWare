end)

-- Cache tool instances when equipping to avoid GetDescendants every frame
local function updateWeaponCache(tool)
    table.clear(cachedWeaponParts)
    if not tool then return end
    
    for _, descendant in pairs(tool:GetDescendants()) do
        if descendant:IsA("Texture") then
            if not removedTexturesCache[descendant] then
                removedTexturesCache[descendant] = { Texture = descendant.Texture }
            end
            descendant.Texture = ""
        elseif descendant:IsA("MeshPart") or descendant:IsA("BasePart") then
            if not originalWeaponProperties[descendant] then
                originalWeaponProperties[descendant] = {
                    Color = descendant.Color,
                    Transparency = descendant.Transparency,
                    Material = descendant.Material,
                    TextureID = descendant:IsA("MeshPart") and descendant.TextureID or nil
                }
            end
            table.insert(cachedWeaponParts, descendant)
        end
    end
end

RunService.RenderStepped:Connect(function()
    local mouseLocationData = UserInputService:GetMouseLocation()
    local viewportSizeData = Camera.ViewportSize
    local screenCenterVector = Vector2.new(viewportSizeData.X / 2, viewportSizeData.Y / 2)
    local screenCenterBottomOffset = Vector2.new(viewportSizeData.X / 2, viewportSizeData.Y)
    
    local isMobile = (UserInputService.TouchEnabled and not UserInputService.MouseEnabled)
    local activeAnchor = isMobile and screenCenterVector or mouseLocationData

    -- Weapon coloring logic (Cached)
    if rainbowWeaponEnabled then
        local characterModelData = LocalPlayer.Character
        if characterModelData then
            local equippedTool = characterModelData:FindFirstChildOfClass("Tool")
            if equippedTool ~= currentEquippedTool then
                currentEquippedTool = equippedTool
                updateWeaponCache(equippedTool)
            end
            
            if #cachedWeaponParts > 0 then
                local hue = (tick() % 3) / 3
                local rainbowColor = Color3.fromHSV(hue, 1, 1)
                for i = 1, #cachedWeaponParts do
                    local part = cachedWeaponParts[i]
                    part.Color = rainbowColor
                    part.Transparency = 0.4
                    part.Material = Enum.Material.Neon
                    if part:IsA("MeshPart") then
                        part.TextureID = ""
                    end
                end
            end
        end
    end

    if aimbotEnabled then
        targetingReticle.main.Radius = aimbotRadius
        targetingReticle.main.Position = activeAnchor
        targetingReticle.main.Visible = true
    else
        targetingReticle.main.Visible = false
    end
    
    local targetLockedOnEnemy = nil
    local closestSelectionDistance = math.huge

    -- Main Rendering Loop
    for npcModel, obj in pairs(cache) do
        if not npcModel or not npcModel.Parent then
            removeEsp(npcModel)
        else
            local targetPart = getTargetPart(npcModel)
            
            if targetPart then
                local magnitudeDistanceCharacterData = (Camera.CFrame.Position - targetPart.Position).Magnitude
                
                -- Skip processing entirely if entity is too far away
                if magnitudeDistanceCharacterData <= maxTargetDistanceStuds then
                    local partCFrame = targetPart.CFrame
                    local topPositionScreenCharacterData, topOnScreenCharacterData = Camera:WorldToViewportPoint((partCFrame * CFrame.new(0, 3, 0)).Position)
                    local bottomPositionScreenCharacterData, bottomOnScreenCharacterData = Camera:WorldToViewportPoint((partCFrame * CFrame.new(0, -3, 0)).Position)
                    
                    if espEnabled and (topOnScreenCharacterData or bottomOnScreenCharacterData) then
                        local heightFrameBoundsCharacterData = math.abs(topPositionScreenCharacterData.Y - bottomPositionScreenCharacterData.Y)
                        local widthFrameBoundsCharacterData = heightFrameBoundsCharacterData * 0.6
                        local xOriginFrameBoundsCharacterData = bottomPositionScreenCharacterData.X - (widthFrameBoundsCharacterData / 2)
                        local yOriginFrameBoundsCharacterData = topPositionScreenCharacterData.Y
                        local xEndFrameBoundsCharacterData = xOriginFrameBoundsCharacterData + widthFrameBoundsCharacterData
                        local yEndFrameBoundsCharacterData = yOriginFrameBoundsCharacterData + heightFrameBoundsCharacterData
                        
                        obj.t.From = Vector2.new(xOriginFrameBoundsCharacterData, yOriginFrameBoundsCharacterData)
                        obj.t.To = Vector2.new(xEndFrameBoundsCharacterData, yOriginFrameBoundsCharacterData)
                        
                        obj.b.From = Vector2.new(xOriginFrameBoundsCharacterData, yEndFrameBoundsCharacterData)
                        obj.b.To = Vector2.new(xEndFrameBoundsCharacterData, yEndFrameBoundsCharacterData)
                        
                        obj.l.From = Vector2.new(xOriginFrameBoundsCharacterData, yOriginFrameBoundsCharacterData)
                        obj.l.To = Vector2.new(xOriginFrameBoundsCharacterData, yEndFrameBoundsCharacterData)
                        
                        obj.r.From = Vector2.new(xEndFrameBoundsCharacterData, yOriginFrameBoundsCharacterData)
                        obj.r.To = Vector2.new(xEndFrameBoundsCharacterData, yEndFrameBoundsCharacterData)
                        
                        obj.t.Visible = true; obj.b.Visible = true; obj.l.Visible = true; obj.r.Visible = true
                        
                        local humanoid = npcModel:FindFirstChildOfClass("Humanoid")
                        if humanoid and magnitudeDistanceCharacterData < 250 then
                            local fontSizeFrameCharacterData = math.clamp(math.floor(13 - (magnitudeDistanceCharacterData / 45)), 9, 13)
                            obj.hp.Size = fontSizeFrameCharacterData
                            obj.hp.Text = math.floor(humanoid.Health) .. "hp"
                            obj.hp.Position = Vector2.new(bottomPositionScreenCharacterData.X, yEndFrameBoundsCharacterData + 2)
                            obj.hp.Visible = true
                        else
                            obj.hp.Visible = false
                        end
                    else
                        obj.t.Visible = false; obj.b.Visible = false; obj.l.Visible = false; obj.r.Visible = false
                        obj.hp.Visible = false
                    end
                    
                    if tracersEnabled and bottomOnScreenCharacterData then
                        obj.tracerMain.From = screenCenterBottomOffset
                        obj.tracerMain.To = Vector2.new(bottomPositionScreenCharacterData.X, bottomPositionScreenCharacterData.Y)
                        obj.tracerMain.Visible = true
                    else
                        obj.tracerMain.Visible = false
                    end

                    if aimbotEnabled and (topOnScreenCharacterData or bottomOnScreenCharacterData) then
                        local screenPos = Vector2.new(bottomPositionScreenCharacterData.X, (topPositionScreenCharacterData.Y + bottomPositionScreenCharacterData.Y) / 2)
                        local screenDistance = (screenPos - activeAnchor).Magnitude
                        
                        if screenDistance < aimbotRadius and screenDistance < closestSelectionDistance then
                            closestSelectionDistance = screenDistance
                            targetLockedOnEnemy = targetPart
                        end
                    end
                else
                    -- Hide drawings for out-of-range entities
                    obj.t.Visible = false; obj.b.Visible = false; obj.l.Visible = false; obj.r.Visible = false
                    obj.tracerMain.Visible = false
                    obj.hp.Visible = false
                end
            else
                obj.t.Visible = false; obj.b.Visible = false; obj.l.Visible = false; obj.r.Visible = false
                obj.tracerMain.Visible = false
                obj.hp.Visible = false
            end
        end
    end

    currentTargetPart = targetLockedOnEnemy

    if currentTargetPart and aimbotEnabled then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, currentTargetPart.Position)
        
        if triggerbotEnabled and not fireDebounce then
            fireDebounce = true
            
            if isMobile then
                local equippedTool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if equippedTool then
                    equippedTool:Activate()
                end
                task.wait(fireRateDelay)
                fireDebounce = false
            else
                task.spawn(function()
                    VirtualInputManager:SendMouseButtonEvent(activeAnchor.X, activeAnchor.Y, 0, true, game, 1)
                    task.wait(0.02)
                    VirtualInputManager:SendMouseButtonEvent(activeAnchor.X, activeAnchor.Y, 0, false, game, 1)
                    task.wait(fireRateDelay)
                    fireDebounce = false
                end)
            end
        end
    end
end)
