-- Optimized Silent Aim Hook
local oldRaycast
oldRaycast = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    
    if silentAimEnabled and currentTargetPart and (method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist") then
        local args = {...}
        local origin = args[1]
        if typeof(origin) == "Vector3" then
            args[2] = (currentTargetPart.Position - origin).Unit * 10000
            return oldRaycast(self, unpack(args))
        end
    end
    return oldRaycast(self, ...)
end)

LocalPlayer.CharacterAdded:Connect(function()
    table.clear(originalWeaponProperties)
    table.clear(removedTexturesCache)
    table.clear(cachedWeaponParts)
