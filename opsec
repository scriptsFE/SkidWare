local targetingReticle = {
    main = Drawing.new("Circle")
}

local function initReticle()
    targetingReticle.main.Thickness = 1
    targetingReticle.main.Color = themeBlueColor
    targetingReticle.main.Radius = aimbotRadius
    targetingReticle.main.Filled = false
    targetingReticle.main.NumSides = 32 -- Reduced from 60 for performance
    targetingReticle.main.Visible = false
end

local function newLine(color, thickness)
    local l = Drawing.new("Line")
    l.Thickness = thickness
    l.Color = color
    l.Transparency = 1
    l.Visible = false
    return l
end

local function getTargetPart(model)
    if not model or not model:IsA("Model") then return nil end
    if model == LocalPlayer.Character or Players:GetPlayerFromCharacter(model) then return nil end
    
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return nil end
    
    return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
end

local function makeEsp(obj)
    if not obj or not obj:IsA("Model") or cache[obj] then return end
    if Players:GetPlayerFromCharacter(obj) or obj == LocalPlayer.Character then return end
    
    -- Simplified box drawing (4 main lines + 1 tracer + 1 text) to drastically reduce RenderStepped overhead
    local objects = {
        t = newLine(themeBlueColor, 1),
        b = newLine(themeBlueColor, 1),
        l = newLine(themeBlueColor, 1),
        r = newLine(themeBlueColor, 1),
        tracerMain = newLine(themeBlueColor, 1),
        hp = Drawing.new("Text")
    }
    
    objects.hp.Center = true
    objects.hp.Outline = true
    objects.hp.OutlineColor = Color3.fromRGB(10, 10, 10)
    objects.hp.Font = Drawing.Fonts.Monospace
    objects.hp.Color = Color3.fromRGB(255, 255, 255)
    
    cache[obj] = objects
end

local function removeEsp(obj)
    if cache[obj] then
        for _, item in pairs(cache[obj]) do
            item:Remove()
        end
        cache[obj] = nil
    end
end

initReticle()

-- Initial scan
for _, descendant in pairs(workspace:GetDescendants()) do
